# Copy to .env.local and fill in. Never commit real values.
# The project uses the office's existing unified Supabase project (see docs/environment-decisions.md).

# Public, browser-safe values (Supabase "publishable" key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (never NEXT_PUBLIC_*). Needed only for the Acessórias
# company sync; the rest of the app works without them.
# Supabase → Project Settings → API Keys → secret key (sb_secret_...).
SUPABASE_SECRET_KEY=
# Acessórias → ⚙ → API Token.
ACESSORIAS_API_TOKEN=
# Random string (>= 32 chars); Vercel Cron sends it as "Authorization: Bearer ...".
CRON_SECRET=
